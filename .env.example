# Long-lived Instagram User Access Token (from Meta Developer Console)
INSTAGRAM_ACCESS_TOKEN=

# App Secret (from Meta Developer Console → App Settings → Basic)
# Used to verify webhook signatures. Leave blank to skip verification in dev.
INSTAGRAM_APP_SECRET=

# Your Instagram Business/Creator account ID (numeric)
INSTAGRAM_ACCOUNT_ID=

# Any string you choose — must match what you enter in Meta webhook setup
VERIFY_TOKEN=my_verify_token

PORT=3000
